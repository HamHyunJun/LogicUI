{
  "name": "@logic-ui-kit/ui",
  "version": "0.2.0",
  "description": "@logic-ui-kit/primitives 위에 Tailwind CSS로 스타일을 입힌 레퍼런스 디자인 시스템",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamHyunJun/LogicUI.git",
    "directory": "packages/ui"
  },
  "homepage": "https://logicui.vercel.app",
  "bugs": {
    "url": "https://github.com/HamHyunJun/LogicUI/issues"
  },
  "keywords": [
    "react",
    "tailwind",
    "tailwindcss",
    "design-system",
    "accessibility",
    "a11y",
    "dialog",
    "tabs",
    "accordion",
    "popover",
    "tooltip",
    "menu",
    "dropdown-menu"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@logic-ui-kit/primitives": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}
