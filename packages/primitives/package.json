{
  "name": "@logic-ui/primitives",
  "version": "0.0.0",
  "description": "스타일 없이 동작·접근성·키보드 인터랙션만 제공하는 헤드리스 React 프리미티브",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dialog": {
      "import": {
        "types": "./dist/dialog/index.d.ts",
        "default": "./dist/dialog/index.mjs"
      },
      "require": {
        "types": "./dist/dialog/index.d.cts",
        "default": "./dist/dialog/index.cjs"
      }
    },
    "./tabs": {
      "import": {
        "types": "./dist/tabs/index.d.ts",
        "default": "./dist/tabs/index.mjs"
      },
      "require": {
        "types": "./dist/tabs/index.d.cts",
        "default": "./dist/tabs/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dialog": [
        "./dist/dialog/index.d.ts"
      ],
      "tabs": [
        "./dist/tabs/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
